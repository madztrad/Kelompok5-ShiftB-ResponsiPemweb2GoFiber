# Server Port (beberapa hosting membaca PORT, lokal bisa memakai APP_PORT)
PORT=3000
APP_PORT=3000

# Database MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASS=
DB_NAME=siminventaris_db

# JWT (WAJIB diganti sebelum server dijalankan)
# Buat secret acak: openssl rand -base64 48  -> tempel hasilnya di bawah.
# Nilai contoh ini akan ditolak server (minimal 32 karakter & bukan nilai contoh).
JWT_SECRET=ganti_dengan_secret_acak_minimal_32_karakter
JWT_EXPIRE_HOURS=24

# CORS (Pisahkan dengan koma jika lebih dari satu origin)
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500
